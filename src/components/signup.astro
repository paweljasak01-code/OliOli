---
---
<section class="sing-up">
    <form action="">
        <div class="form-grid">
            <div class="name">
                <label for="name">Name:</label>
                <input type="text" id="name" name="name" placeholder="Name" required>
            </div>
            <div class="lastname">
                <label for="lastname">Last Name:</label>
                <input type="text" id="lastname" name="lastname" placeholder="Last Name" required>
            </div>

            <div class="email">
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" placeholder="Email" required>
            </div>
            <div class="phone">
                <label for="phone">Phone number:</label>
                <input type="tel" id="phone" name="phone" placeholder="Phone number" required>
            </div>

            <div class="address">
                <label for="address">Address:</label>
                <input type="text" id="address" name="address" placeholder="Address" required>
            </div>

            <div class="course">
                <label for="course">Select course</label>
                <select name="course" id="course" required>
                    <option value="" disabled selected hidden>select</option>
                    <option value="">Beginner</option>
                    <option value="">Intermediate</option>
                    <option value="">Advanced</option>
                    <option value="">Grammar</option>
                    <option value="">Conversation</option>
                    <option value="">Travel</option>
                    <option value="">Culture</option>
                </select>
            </div>
            <div class="startdate">
                <label for="startdate">Select start date:</label>
                <input type="date" id="startdate" name="startdate" required>
            </div>

            <div class="address">
                <label for="duration">Duration:</label>
                <select name="duration" id="duration" required>
                    <option value="" disabled selected hidden>select</option>
                    <option value="">1 week</option>
                    <option value="">2 weeks</option>
                </select>
            </div>

            <button type="submit">SIGN UP</button>
        </div>
    </form>

</section>

<style>
*{
        box-sizing: border-box;
    }
.sing-up {
    justify-content: center;
    align-items: center;
}
form {
    margin: 0 auto;
    max-width: 31.25rem;
    background-color: #ffffff;
    border: 0.1875rem solid #000;
    border-radius: 1.5rem;
    padding: 1.5rem;
    width: 100%;
    overflow: hidden;
}
.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
}
.name, .lastname, .email, .phone, .course, .startdate {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    background-color: #ffffff;
}
.address {
    grid-column: 1 / -1;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
}
label {
    margin-top: 0.625rem;
    font-weight: 800;
}
input, select {
    min-width: 0;
    padding: 0.9375rem 0.2rem;
    border: #000 0.1875rem solid;
    border-radius: 1.25rem;
    width: 100%;

    transition: border-color 0.3s ease;
}
input:focus {
    outline: none;
}

#name:hover, #name:focus{
    border-color: rgba(245, 173, 228);

}
#lastname:hover, #lastname:focus{
    border-color: rgba(171, 99, 73);
}
#email:hover, #email:focus{
    border-color: rgba(63, 105, 236);
}
#phone:hover, #phone:focus{
    border-color: rgba(243, 66, 44);
}
#address:hover, #address:focus{
    border-color: rgba(0, 147, 92);
}
#startdate:hover, #startdate:focus{
    border-color: rgba(255, 138, 79);
}
#course:hover, #course:focus{
    border-color: rgba(164, 90, 254);
}
#duration:hover, #duration:focus{
    border-color: #fff570;
}
button {
    margin-top: 1.25rem;
    padding: 0.9375rem;
    background-color: #ffffff;
    border: #000 0.1875rem solid;
    border-radius: 1.75rem;
    font-weight: 800;
    cursor: pointer;
    width: 100%;
    grid-column: 1 / -1;
}
button:hover {
    background-color: #fff570;
}
@media (max-width: 700px) {
    .sing-up {
    padding: 0 1rem;
 }
}
</style>