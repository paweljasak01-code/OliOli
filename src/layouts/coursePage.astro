---
import BasePage from "./basePage.astro"
import PageDivider from "../components/page_divider.astro"
---
<BasePage>
    <Fragment slot="hero">
        <section class="hero-courses">
            <slot name="hero-courses" />
        </section>
    </Fragment>
    <Fragment slot="content">
        <section class="course-description">
            <slot name="course-description" />
        </section>
        <PageDivider />
        <section class="about-course">
            <slot name="about-course" />
        </section>
    </Fragment>
</BasePage>
