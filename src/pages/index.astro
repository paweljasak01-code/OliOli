---
import "../styles/styleIndex.css"
import BasePage from "../layouts/basePage.astro"
import PageDivider from "../components/page_divider.astro"
import Courses from "../components/courses.astro"
import Teachers from "../components/teachers.astro"
import Form from "../components/signup.astro"
---

<BasePage>
		<Fragment slot="hero">
			<section class="hero-text">
	   	    	<h1>Learn <span class="red">español</span> <br> by living it.</h1>
				<a class="start-button" href="#sign-up">Start now</a>			
			</section>
		</Fragment>
		<Fragment slot="content">
				<section class="about-school" id="about">
					<div class="school-img">
						<img src="/src/assets/photos/simbol_black.png" alt="OliOli">
					</div>
					<div class="about">
						<h2>About our language school</h2>
						      <p><em>Oli</em> is how locals say hello in Valencia. Say it twice and you've got a conversation. That's exactly what we're about.</p>
        				 	  <p>OliOli is a Spanish school in Valencia where professional teaching meets real Mediterranean life. Our teachers know their stuff, the community is genuinely warm, and what you learn in class actually makes sense the moment you step outside. The city is part of how we teach.</p>
        					  <p>Because learning Spanish with us is not just about getting the grammar right. It is about feeling at home in a new language, in a new place. <em>¿Empezamos?</em></p>
					</div>
				</section>
			<PageDivider />
				<section class="courses" id="courses">
					<div class="courses-text">
						<h2>Our Courses</h2>
						<p>something about courses</p>
					</div>
					<Courses />
				</section>
			<PageDivider />
				<section class="why-us">
						<h2>WHY LEARN WITH <span class="yellow">OLIOLI?</span></h2>
						<p>Lorem ipsum dolor sit, amet consectetur adipisicing elit. Fugiat molestiae magnam voluptate rem dicta, quis enim, consequuntur omnis debitis earum veritatis a minus sint ullam? Molestias facere enim corrupti iste.</p>
				</section>
			<PageDivider />
				<section class="teachers" id="teachers">
					<div class="teachers-text">
						<h2>Our Teachers</h2>
						<p>something about teachers</p>
					</div>
				<Teachers />
				</section>
			<PageDivider />
			    <section class="why-spanish">
						<ul>
							<li>Lorem ipsum dolor sit amet consectetur adipisicing elit. Tempore assumenda eos</li>
							<li>Lorem ipsum dolor sit amet consectetur adipisicing elit. Tempore assumenda eos</li>
							<li>Lorem ipsum dolor sit amet consectetur adipisicing elit. Tempore assumenda eos</li>
							<li>Lorem ipsum dolor sit amet consectetur adipisicing elit. Tempore assumenda eos</li>
						</ul>
						<h2>WHY LEARN <span class="red">SPANISH?</span></h2>
				</section>
			<PageDivider />
				<section class="sing-up" id="sign-up">
					<h2>Sign Up</h2>
					<Form />
				</section>
		</Fragment>
</BasePage>

